# Copy this file to ".env.local" and fill in values. Restart dev server after changes.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://offgriddiet.com

# --- Waitlist email provider (pick ONE; first one set wins) ---
# Without any of these, signups work but are only logged to the server console
# (NOT saved). Connect a provider to actually build your email list.

# 1) MailerLite (recommended — generous free tier)
#    Create an API token at app.mailerlite.com > Integrations > API.
MAILERLITE_API_KEY=
#    Optional: add subscribers straight into a specific group/list.
MAILERLITE_GROUP_ID=

# 2) Buttondown
BUTTONDOWN_API_KEY=

# 3) Resend Audiences
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
